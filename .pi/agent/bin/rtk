#!/usr/bin/env bash
set -euo pipefail

# Stable RTK shim for Pi extensions. Pi prepends ~/.pi/agent/bin to PATH,
# so this ensures pi-rtk-optimizer uses the RTK build that supports
# `rtk rewrite` instead of an older binary elsewhere on PATH.
for candidate in \
  "$HOME/.local/bin/rtk" \
  "$HOME/.cargo/bin/rtk" \
  "/opt/homebrew/bin/rtk" \
  "/usr/local/bin/rtk"; do
  if [ -x "$candidate" ] && [ "$candidate" != "$0" ]; then
    exec "$candidate" "$@"
  fi
done

echo "rtk not found. Install RTK so pi-rtk-optimizer can use 'rtk rewrite'." >&2
exit 127
